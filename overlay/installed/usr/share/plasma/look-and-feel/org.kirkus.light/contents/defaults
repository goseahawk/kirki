# The kirki Light Global Theme: what "Apply" in System Settings → Global Theme sets: the kirki
# Light colours and icons, and the kirki Plasma Style, wallpaper and splash. Window borders are
# KDE's Breeze, in the kirki Light colours. The dark twin is org.kirkus.splash.

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=KirkusLight

[kdeglobals][Icons]
Theme=kirkus-light

[plasmarc][Theme]
name=kirkus

[Wallpaper]
Image=kirkus

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[kwinrc][WindowSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[ksplashrc][KSplash]
Theme=org.kirkus.splash
